@page
@model EditModel

@{
    ViewData["Title"] = "Edit Assignment";
}

<h1>Düzenle</h1>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="CompaniesRoles.Id" />
            
            <div class="form-group mb-3">
                <label asp-for="CompaniesRoles.CompanyId" class="control-label">Þirket</label>
                <select asp-for="CompaniesRoles.CompanyId" class="form-control" asp-items="Model.CompaniesRequests"></select>
                <span asp-validation-for="CompaniesRoles.CompanyId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="CompaniesRoles.RoleId" class="control-label">Rol</label>
                <select asp-for="CompaniesRoles.RoleId" class="form-control" asp-items="Model.RolesRequests"></select>
                <span asp-validation-for="CompaniesRoles.RoleId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary">Kaydet</button>
                <a asp-page="./Index" class="btn btn-secondary">Liste</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

@using System.Web
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>@Html.Raw(HttpUtility.HtmlEncode(ViewData["Title"]))</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Offers.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="wrapper">
        <!-- Sidebar -->
        <nav id="sidebar" class="sidebar">
            <div class="sidebar-header">
                <h3><i class="bi bi-building"></i> Teklif Yönetimi</h3>
            </div>

            <ul class="list-unstyled components">
                <li>
                    <a asp-area="" asp-page="/Index">
                        <i class="bi bi-house-door"></i>
                        <span>Anasayfa</span>
                    </a>
                </li>
                <li>
                    <a asp-area="" asp-page="/ProjectOwners/Index">
                        <i class="bi bi-people"></i>
                        <span>Yatırımcılar</span>
                    </a>
                </li>
                <li>
                    <a asp-area="" asp-page="/ConsultantCompanies/Index">
                        <i class="bi bi-briefcase"></i>
                        <span>Danışmanlar</span>
                    </a>
                </li>
                <li>
                    <a asp-area="" asp-page="/Offers/Index">
                        <i class="bi bi-folder"></i>
                        <span>Projeler</span>
                    </a>
                </li>
                <li>
                    <a asp-area="" asp-page="/Equipment/List">
                        <i class="bi bi-tools"></i>
                        <span>Ekipmanlar</span>
                    </a>
                </li>
                <li>
                    <a asp-area="" asp-page="/EquipmentModels/Index">
                        <i class="bi bi-box-seam"></i>
                        <span>Ekipman Markaları</span>
                    </a>
                </li>
                <li>
                    <a asp-area="" asp-page="/Companies/Index">
                        <i class="bi bi-building"></i>
                        <span>Şirketler</span>
                    </a>
                </li>
                
                @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                {
                    <li class="sidebar-divider"></li>
                    <li class="sidebar-heading">Yönetim</li>
                    <li>
                        <a asp-page="/Users/Index">
                            <i class="bi bi-person-badge"></i>
                            <span>Kullanıcılar</span>
                        </a>
                    </li>
                    <li>
                        <a asp-page="/Roles/Index">
                            <i class="bi bi-shield-lock"></i>
                            <span>Roller</span>
                        </a>
                    </li>
                    <li>
                        <a asp-page="/CompaniesRoles/Index">
                            <i class="bi bi-diagram-3"></i>
                            <span>Şirket Rolleri</span>
                        </a>
                    </li>
                }
            </ul>
        </nav>

        <!-- Page Content -->
        <div id="content">
            <!-- Top Navigation Bar -->
            <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom">
                <div class="container-fluid">
                    <button type="button" id="sidebarCollapse" class="btn btn-link">
                        <i class="bi bi-list"></i>
                    </button>

                    <div class="ms-auto d-flex align-items-center">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <div class="dropdown">
                                <button class="btn btn-link dropdown-toggle text-decoration-none" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle me-1"></i>
                                    <span>@User.Identity.Name</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                    <li>
                                        <a class="dropdown-item" asp-page="/Account/ChangePassword">
                                            <i class="bi bi-key me-2"></i>Şifre Değiştir
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form method="post" action="/Account/Logout" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item">
                                                <i class="bi bi-box-arrow-right me-2"></i>Çıkış
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-primary" asp-page="/Account/Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Giriş
                            </a>
                        }
                    </div>
                </div>
            </nav>

            <!-- Main Content -->
            <div class="container-fluid py-4">
                <main role="main">
                    @RenderBody()
                </main>
            </div>

@*             <!-- Footer -->
            <footer class="footer mt-auto py-3 bg-light border-top">
                <div class="container-fluid text-center text-muted">
                    <small>&copy; 2025 - Tenders Management System</small>
                </div>
            </footer> *@
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            $('#sidebarCollapse').on('click', function () {
                $('#sidebar').toggleClass('active');
                $('#content').toggleClass('active');
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

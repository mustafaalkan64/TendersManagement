@page
@model EquipmentListModel
@{
    ViewData["Title"] = "Ekipman Listesi";
    Response.Headers["Content-Type"] = "text/html; charset=utf-8";
}

<h1>@ViewData["Title"]</h1>


<div class="row mb-3">
    <div class="col-md-6">
        <div class="input-group">
            <input type="text" id="searchInput" class="form-control" placeholder="Ekipmanlar içinde ara.."
                   value="@Model.SearchString" />
            <button class="btn btn-outline-secondary" type="button" onclick="search()">
                <i class="bi bi-search"></i> Ara
            </button>
            @if (!string.IsNullOrEmpty(Model.SearchString))
            {
                <button class="btn btn-outline-secondary" type="button" onclick="clearSearch()">
                    <i class="bi bi-x"></i> Temizle
                </button>
            }
        </div>
    </div>
    <div class="col-md-6 text-end">
        <a asp-page="Create" class="btn btn-primary">Yeni Ekipman</a>
    </div>
</div>

<table class="table">
    <thead>
        <tr>
            <th>Adı</th>
            <th>Açıklaması</th>
            <th>Aksiyonlar</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Equipment)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Description</td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-warning">Düzenle</a>
                    <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-danger">Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<nav aria-label="Page navigation" class="mt-4">
    <ul class="pagination justify-content-center">
        <li class="page-item @(Model.Equipment.PageIndex == 1 ? "disabled" : "")">
            <a class="page-link" asp-page="./List" asp-route-pageIndex="1" asp-route-searchString="@Model.SearchString">İlk</a>
        </li>
        <li class="page-item @(Model.Equipment.HasPreviousPage ? "" : "disabled")">
            <a class="page-link" asp-page="./List" asp-route-pageIndex="@(Model.Equipment.PageIndex - 1)" asp-route-searchString="@Model.SearchString">Önceki</a>
        </li>
        @for (var i = 1; i <= Model.Equipment.TotalPages; i++)
        {
            <li class="page-item @(i == Model.Equipment.PageIndex ? "active" : "")">
                <a class="page-link" asp-page="./List" asp-route-pageIndex="@i" asp-route-searchString="@Model.SearchString">@i</a>
            </li>
        }
        <li class="page-item @(Model.Equipment.HasNextPage ? "" : "disabled")">
            <a class="page-link" asp-page="./List" asp-route-pageIndex="@(Model.Equipment.PageIndex + 1)" asp-route-searchString="@Model.SearchString">Sonraki</a>
        </li>
        <li class="page-item @(Model.Equipment.PageIndex == Model.Equipment.TotalPages ? "disabled" : "")">
            <a class="page-link" asp-page="./List" asp-route-pageIndex="@Model.Equipment.TotalPages" asp-route-searchString="@Model.SearchString">Son</a>
        </li>
    </ul>
</nav>
 

 @section Scripts {
    <script>

        function search() {
            const searchValue = document.getElementById('searchInput').value;
            window.location.href = `?searchString=${encodeURIComponent(searchValue)}`;
        }

        function clearSearch() {
            window.location.href = '?';
        }

        // Add event listener for Enter key
        document.getElementById('searchInput').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                search();
            }
        });
    </script>
}

